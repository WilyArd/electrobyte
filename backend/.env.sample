# Database Connection String
# Contoh: postgresql://username:password@localhost:5432/electrobyte?sslmode=disable
DATABASE_URL="postgresql://username:password@localhost:5432/electrobyte?sslmode=disable"

# JWT Secret (Harus sama dengan NEXTAUTH_SECRET di frontend/.env)
# Generate dengan perintah: openssl rand -base64 32
NEXTAUTH_SECRET="ganti_dengan_jwt_secret_yang_aman_minimal_32_karakter"

# Inter-service URLs (Untuk development lokal non-docker)
PRODUCT_SERVICE_URL=http://localhost:4002
CART_SERVICE_URL=http://localhost:4003

# MinIO / S3-compatible Object Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=electrobyte
MINIO_SECRET_KEY=electrobyte_secret
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000

# Traefik API Gateway Entrypoint URL
TRAEFIK_URL=http://localhost:3000
